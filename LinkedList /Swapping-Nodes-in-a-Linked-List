/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* swapNodes(ListNode* head, int k) {
       ListNode* curr = head;
       int count = 1;
       int length = 0;
       while(curr != NULL){
        length++;
        curr = curr -> next;
       }
       curr = head;
       int klastNode = length -k +1;
       ListNode* left = head;
       ListNode* right = head;
       while(curr != NULL){
        if(count < k){
            left = left -> next;
        }
        if(count < klastNode){
            right = right -> next;
        }
        curr = curr -> next;
        count++;
       }

       int temp = left -> val;
       left -> val = right -> val;
       right -> val = temp;

       return head;
    }
};
